# Copy to .env.local and fill in values. See SECRETS.md and SUPABASE_SETUP.md.

# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify (required to connect a store via OAuth)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Security + Rate Limiting (required for production)
ENCRYPTION_KEY= # 32-byte hex for AES-256-GCM
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional for other features
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
